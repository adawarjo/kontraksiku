# Konfigurasi database KHUSUS pengujian. Salin menjadi .env.testing.
# PERINGATAN: database ini akan DIHAPUS dan dibuat ulang setiap kali pengujian dijalankan.
APP_ENV=testing
APP_ALLOW_REGISTRATION=true
APP_TIMEZONE=Asia/Jakarta
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kontraksiku_test
DB_USERNAME=root
DB_PASSWORD=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
