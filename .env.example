# Salin file ini menjadi .env lalu sesuaikan nilainya.
# File .env berada di luar folder public sehingga tidak dapat diakses dari browser.

APP_NAME=KontraksiKu
# production atau development (development menampilkan detail error di log saja, tidak ke pengguna)
APP_ENV=production
# true = pengguna baru boleh mendaftar sendiri; false = halaman registrasi ditutup
APP_ALLOW_REGISTRATION=true
# Zona waktu tampilan. Database selalu menyimpan UTC.
APP_TIMEZONE=Asia/Jakarta
# Lama sesi login (menit) tanpa aktivitas sebelum harus login ulang
SESSION_LIFETIME_MINUTES=720
# Paksa cookie hanya lewat HTTPS (otomatis true jika aplikasi diakses via HTTPS)
SESSION_SECURE_COOKIE=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kontraksiku
DB_USERNAME=root
DB_PASSWORD=

# Pembatasan login: maksimal percobaan gagal dalam jendela waktu (menit)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
